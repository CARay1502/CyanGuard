# "local" = no AWS needed (synthetic Cyan + rule-based checker + JSON file).
# "aws"   = Bedrock plays Cyan, Bedrock reviews compliance, DynamoDB stores reviews.
APP_MODE=local

# Local mode
REVIEWS_FILE=data/reviews.json

# AWS mode (credentials come from your normal AWS profile/env, never this file)
AWS_REGION=us-east-1
REVIEWS_TABLE=cyanguard-reviews
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional: a separate (e.g. stronger) model for the compliance review.
# COMPLIANCE_MODEL_ID=
