# "local" = no AWS needed (synthetic Cyan + rule-based checker + JSON file).
# "aws"   = Bedrock plays Cyan, Bedrock reviews compliance, DynamoDB stores reviews.
APP_MODE=local

# Local mode: one JSON file per collection (reviews.json, users.json, ...)
DATA_DIR=data

# Login. Demo accounts (analyst, compliance, admin) are created on first sign-in with
# this password, which the login page shows. Defaults to "cyanguard-demo" in both modes.
# DEMO_PASSWORD=cyanguard-demo
# Signs session cookies. Local mode generates one in DATA_DIR if unset.
# AWS mode: REQUIRED, as a Lambda environment variable (a long random string).
# SESSION_SECRET=
# SESSION_HOURS=8

# AWS mode (credentials come from your normal AWS profile/env, never this file)
AWS_REGION=us-east-1
# One table for everything: partition key `collection`, sort key `id` (both String)
DATA_TABLE=cyanguard-data
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Optional: a separate (e.g. stronger) model for the compliance review.
# COMPLIANCE_MODEL_ID=
